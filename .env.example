# ── 이 파일을 복사해서 .env.local 파일을 만드세요 ──────────────
# 아무것도 채우지 않아도 앱은 돌아갑니다. (임시 저장 모드)
# 실제 수업에서는 아래 두 줄을 채워야 기록이 안전하게 남습니다.

# Supabase 프로젝트 주소 (Settings → API → Project URL)
SUPABASE_URL=

# Supabase 비밀 열쇠 (Settings → API → service_role key)
# ⚠️ 이 값은 절대 다른 사람에게 보여주면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 아래는 나중 단계(질문 업그레이드 화면)에서 씁니다 ──────────
# AI에게 한 번 물어보는 기능을 켤 때만 채우세요.
AI_API_KEY=
